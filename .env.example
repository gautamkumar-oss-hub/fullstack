# Copy to .env for local development. Never commit .env or real credentials.
COMPOSE_PROJECT_NAME=hospital-appointment
POSTGRES_DB=hospital_appointment
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/hospital_appointment
DB_USERNAME=hospital_app
DB_PASSWORD=replace-with-a-local-password
CLINIC_TIME_ZONE=UTC
SERVER_PORT=8080
VITE_API_TARGET=http://localhost:8080

# These three values must match the SPA deployment and API token validation.
IDENTITY_ISSUER=http://localhost:8080
IDENTITY_AUDIENCE=hospital-appointment-spa
IDENTITY_KEY_ID=replace-with-a-key-version
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure cookies are the default outside dev; the dev profile permits insecure
# cookies on the default loopback origins. Leave this unset for local HTTP.
# Do not override it to false outside dev.
# IDENTITY_COOKIE_SECURE=true

# Plain dev uses SMTP; dev,identity-dev uses isolated no-delivery diagnostics.
# Outside dev, SMTP, a sender, and spring.mail.host are required.
IDENTITY_EMAIL_PROVIDER=smtp
IDENTITY_EMAIL_FROM=no-reply@example.test
# SPRING_MAIL_HOST=smtp.example.test
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=replace-with-an-smtp-user
# SPRING_MAIL_PASSWORD=replace-with-an-smtp-secret
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# Required outside dev. Store complete PEM values in a secret manager, including
# BEGIN/END lines and encoded newlines where required by the deployment system.
# IDENTITY_PRIVATE_KEY_PEM=replace-with-a-pkcs8-private-key-from-a-secret-manager
# IDENTITY_PUBLIC_KEY_PEM=replace-with-the-matching-x509-public-key

# Optional one-time initial administrator. Use a unique secret of 16+ characters,
# start once, then set this to false and remove the bootstrap credentials.
IDENTITY_BOOTSTRAP_ENABLED=false
# IDENTITY_BOOTSTRAP_EMAIL=admin@example.test
# IDENTITY_BOOTSTRAP_PASSWORD=replace-with-a-unique-secret
# IDENTITY_BOOTSTRAP_FIRST_NAME=System
# IDENTITY_BOOTSTRAP_LAST_NAME=Administrator

# Never enable IDENTITY_MFA_BYPASS or set IDENTITY_EXPOSED_MFA_CODE here.
# Those diagnostics belong only to the dev,identity-dev profile combination.
